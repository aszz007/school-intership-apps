{
  "name": "shiye-reader",
  "productName": "拾页阅读器",
  "version": "0.3.4",
  "description": "离线桌面阅读器，保存书籍与阅读位置。",
  "author": "aszz007",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "npm run build && node scripts/preview.mjs",
    "test": "node --test test/*.test.mjs",
    "fixtures": "node scripts/create-fixtures.mjs",
    "package": "npm run build && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": {
        "global-agent": "4.1.3"
      }
    }
  },
  "build": {
    "appId": "cn.aszz007.shiye.reader",
    "productName": "拾页阅读器",
    "directories": {
      "output": "release/v0.3.4"
    },
    "files": [
      "dist/**",
      "electron/**",
      "core/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signExecutable": false
    }
  }
}
